# XP environment template — copy to .env and adjust. NEVER commit real secrets.
# Local development requires NO production secrets (phase 1 acceptance).

# -- environment ---------------------------------------------------------------
XP_ENV=dev
XP_LOG_LEVEL=INFO
# DEV_MODE relaxes auth for local development ONLY. Must be false in staging+.
XP_DEV_MODE=true

# -- database -------------------------------------------------------------------
# Local zero-dependency default:
XP_DATABASE_URL=sqlite+aiosqlite:///./data/xp-dev.db
# With infra/docker-compose.yml:
# XP_DATABASE_URL=postgresql+asyncpg://xp:xp_dev_only@localhost:5432/xp

# -- queue -----------------------------------------------------------------------
# Set to enable the arq worker; unset => worker jobs run inline (dev only).
# XP_REDIS_URL=redis://localhost:6379/0

# -- artifacts -------------------------------------------------------------------
XP_ARTIFACT_DIR=./data/artifacts

# -- pricing (published conversion; pricing_requirements #1) ----------------------
XP_SATS_PER_XP=10

# -- telegram ---------------------------------------------------------------------
# Create with @BotFather. The bot NEVER asks users for seeds or private keys.
# XP_TELEGRAM_BOT_TOKEN=123456:ABC-your-token
XP_MINI_APP_URL=https://t.me/YourBot/app

# -- agent runtime (DeepSeek) ------------------------------------------------------
# OpenAI-compatible endpoint. Without a key the adapter runs in stub mode.
# XP_DEEPSEEK_API_KEY=sk-...
XP_DEEPSEEK_BASE_URL=https://api.deepseek.com
XP_DEEPSEEK_MODEL=deepseek-chat
# Pin after the phase-0 integration spike (dsh_integration requirement #1):
XP_DSH_REVISION=unpinned-spike-0

# -- wallet (phase-3, decision D10) --------------------------------------------
XP_WALLET_DATA_DIR=./data/wallets
# bitcoind RPC: leave unset to run wallet flows without a chain source
XP_BITCOIND_RPC_URL=
XP_BITCOIND_RPC_USER=
XP_BITCOIND_RPC_PASSWORD=
XP_WALLET_UNLOCK_TTL_MINUTES=10
XP_WALLET_FALLBACK_FEE_RATE_SAT_VB=2
XP_WALLET_MAX_FEE_RATE_SAT_VB=50
XP_WALLET_DEFAULT_WORD_COUNT=24

# -- lightning (phase-4, decision D11) -----------------------------------------
# canned = deterministic in-memory semantics provider (dev/test, disclosed)
# lnd    = real gRPC adapter to a pinned lnd v0.21.4-beta node
XP_LIGHTNING_MODE=canned
XP_LIGHTNING_NETWORK=regtest
# required only when XP_LIGHTNING_MODE=lnd
XP_LND_RPC_HOST=
XP_LND_TLS_CERT_PATH=
XP_LND_MACAROON_PATH=
XP_LIGHTNING_INVOICE_EXPIRY_SECONDS=3600
XP_LIGHTNING_BASE_FEE_MSAT=1000
XP_LIGHTNING_FEE_PPM=1
XP_LIGHTNING_MAX_FEE_MSAT=10000
XP_LIGHTNING_MIN_INBOUND_MSAT=1000000

# -- XP economy (phase 5, finalized) --------------------------------------------
# ONE canonical conversion; every surface derives its display from it.
XP_XP_PER_SAT=100
# Published XP pack table (satoshi sizes), JSON list.
XP_XP_PACK_SATS=[1000, 5000, 20000]
# Scheduled reconciliation cadence for the worker (billing_flow #8).
XP_RECONCILE_INTERVAL_SECONDS=3600

# -- agent runtime (phase 6) ------------------------------------------------------
# Deterministic backend enforcement of plan bounds.
XP_AGENT_MAX_STEPS=12
XP_AGENT_DEFAULT_TOOL_TIMEOUT_SECONDS=30
XP_AGENT_MAX_BUDGET_XP=100000
