# XP environment template - copy to .env and adjust. NEVER commit real secrets.
# Local development requires NO production secrets (phase 1 acceptance).

# environment
XP_ENV=dev
XP_LOG_LEVEL=INFO
# DEV_MODE relaxes auth for local development ONLY. Must be false in staging+.
XP_DEV_MODE=true

# database
# Local zero-dependency default:
XP_DATABASE_URL=sqlite+aiosqlite:///./data/xp-dev.db
# With infra/docker-compose.yml:
# XP_DATABASE_URL=postgresql+asyncpg://xp:xp_dev_only@localhost:5432/xp

# queue
# Set to enable the arq worker; unset => worker jobs run inline (dev only).
# XP_REDIS_URL=redis://localhost:6379/0

# artifacts
XP_ARTIFACT_DIR=./data/artifacts

# pricing (ONE canonical conversion, published; clients must re-check)
XP_XP_PER_SAT=100

# telegram
# Create with @BotFather. The bot NEVER asks users for seeds or private keys.
# XP_TELEGRAM_BOT_TOKEN=123456:ABC-your-token
XP_MINI_APP_URL=https://t.me/YourBot/app
# Notification relay (worker): canned records a local receipt only;
# bot_api sends for real and requires XP_TELEGRAM_BOT_TOKEN.
XP_TELEGRAM_RELAY_MODE=canned
XP_TELEGRAM_RELAY_LOOKBACK_HOURS=24
XP_RELAY_SWEEP_INTERVAL_SECONDS=60

# agent runtime (DeepSeek)
# OpenAI-compatible endpoint. Without a key the adapter runs in stub mode.
# XP_DEEPSEEK_API_KEY=sk-...
XP_DEEPSEEK_BASE_URL=https://api.deepseek.com
XP_DEEPSEEK_MODEL=deepseek-chat
# Pin after the phase-0 integration spike (dsh_integration requirement #1):
XP_DSH_REVISION=unpinned-spike-0

# wallet (phase-3, decision D10)
XP_WALLET_DATA_DIR=./data/wallets
# bitcoind RPC: leave unset to run wallet flows without a chain source
XP_BITCOIND_RPC_URL=
XP_BITCOIND_RPC_USER=
XP_BITCOIND_RPC_PASSWORD=
XP_WALLET_UNLOCK_TTL_MINUTES=10
XP_WALLET_FALLBACK_FEE_RATE_SAT_VB=2
XP_WALLET_MAX_FEE_RATE_SAT_VB=50
XP_WALLET_DEFAULT_WORD_COUNT=24

# lightning (phase-4, decision D11)
# canned = deterministic in-memory semantics provider (dev/test, disclosed)
# lnd    = real gRPC adapter to a pinned lnd v0.21.4-beta node
XP_LIGHTNING_MODE=canned
XP_LIGHTNING_NETWORK=regtest
# required only when XP_LIGHTNING_MODE=lnd
XP_LND_RPC_HOST=
XP_LND_TLS_CERT_PATH=
XP_LND_MACAROON_PATH=
XP_LIGHTNING_INVOICE_EXPIRY_SECONDS=3600
XP_LIGHTNING_BASE_FEE_MSAT=1000
XP_LIGHTNING_FEE_PPM=1
XP_LIGHTNING_MAX_FEE_MSAT=10000
XP_LIGHTNING_MIN_INBOUND_MSAT=1000000

# XP economy (phase 5, finalized)
# ONE canonical conversion; every surface derives its display from it.
XP_XP_PER_SAT=100
# Published XP pack table (satoshi sizes), JSON list.
XP_XP_PACK_SATS=[1000, 5000, 20000]
# Scheduled reconciliation cadence for the worker (billing_flow #8).
XP_RECONCILE_INTERVAL_SECONDS=3600

# agent runtime (phase 6)
# Deterministic backend enforcement of plan bounds.
XP_AGENT_MAX_STEPS=12
XP_AGENT_DEFAULT_TOOL_TIMEOUT_SECONDS=30
XP_AGENT_MAX_BUDGET_XP=100000

# research tools (phase 7)
# search: canned only (a live provider needs a search API key - none configured).
XP_RESEARCH_SEARCH_MODE=canned
# fetch: canned (offline eval corpus) or http (real retrieval behind FetchPolicy).
XP_RESEARCH_FETCH_MODE=canned
XP_RESEARCH_FETCH_MAX_BYTES=262144
XP_RESEARCH_FETCH_TIMEOUT_SECONDS=20
# Repeatable research evaluation set (phase-7 acceptance #5), repo-root relative.
XP_RESEARCH_EVAL_SET_PATH=tests/data/research_eval_set.json

# commerce intelligence (phase 8)
# Scoring factor weights (JSON). Factor names are fixed; weights are operator-
# configurable. Any defect falls back to documented defaults WITH a disclosure.
# XP_COMMERCE_SCORING_FACTORS={"distinct_sources": 2.0, "supplier_count": 1.5, "price_spread": 1.5, "freshness": 1.0, "attribute_completeness": 1.0}
# Commerce fixture corpus + repeatable evaluation set (repo-root relative).
XP_COMMERCE_EVAL_SET_PATH=tests/data/commerce_eval_set.json

# connections + email (phase 9)
# Master key for the credential vault (Fernet over a sha256-derived key).
# NEVER logged, never returned by any API. Dev mode uses a documented fallback
# key and DISCLOSES it on every response; non-dev refuses to link without one.
# XP_CONNECTIONS_CREDENTIAL_KEY=<generate with: python -c "import secrets; print(secrets.token_urlsafe(32))">
# email.send delivery mode: canned (deterministic, no network) | smtp (real).
XP_EMAIL_SEND_MODE=canned

# approvals + automation (phase 9)
# Approval decisions bind to the action digest AND expire after this window.
XP_APPROVAL_TTL_MINUTES=60
# Scheduler sweep cadence + crash-recovery window + failure ladder.
XP_AUTOMATION_SWEEP_INTERVAL_SECONDS=60
XP_AUTOMATION_RUN_STALE_SECONDS=3600
XP_AUTOMATION_MAX_CONSECUTIVE_FAILURES=3
# Operator caps on per-job budgets (user input beyond these is refused).
XP_AUTOMATION_MAX_BUDGET_PER_RUN_XP=10000
XP_AUTOMATION_MAX_BUDGET_TOTAL_XP=100000

# phase 10: abuse controls
# Kill switch for the per-process token-bucket rate limiter. Route-class
# limits are code-pinned in xp_core/services/ratelimit.py (auth 10/min,
# money 60/min, agent 30/min, reads 300/min) - see docs/security-review.md
# for the multi-worker Redis upgrade path.
XP_RATE_LIMIT_ENABLED=true

# phase 10: privacy / retention (days)
XP_RETENTION_SESSIONS_DAYS=7
XP_RETENTION_NOTIFICATIONS_READ_DAYS=30
XP_RETENTION_NOTIFICATIONS_UNREAD_DAYS=90
XP_RETENTION_AUTOMATION_RUNS_DAYS=180
XP_RETENTION_EMAIL_DRAFTS_SENT_DAYS=30
