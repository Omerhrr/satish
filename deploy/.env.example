# Copy to deploy/.env and fill in. Never commit deploy/.env.
PUBLIC_URL=https://satish.rogan.live

# In-app wallet network: testnet (free test coins, default) or mainnet
# (real bitcoin). Wallets are per network: switching shows a separate wallet.
BITCOIN_NETWORK=testnet

# Your bot's username without @ (e.g. XPWalletBot), for payment links.
BOT_USERNAME=

# Lightning wallet (Breez SDK, Spark), runs on the user's phone with the same 12 words.
# Empty = "regtest" (free test coins from https://app.lightspark.com/regtest-faucet, no key)
# while BITCOIN_NETWORK=testnet, and "mainnet" when BITCOIN_NETWORK=mainnet.
LIGHTNING_NETWORK=
# Needed for mainnet Lightning. Free: https://breez.technology/request-api-key/
# (it's a client key, shipped to the browser).
BREEZ_API_KEY=
# Mainnet only: above this balance (sats) Satish suggests keeping savings elsewhere.
WALLET_BETA_LIMIT_SATS=1000000

# From @BotFather
XP_TELEGRAM_BOT_TOKEN=
XP_MINI_APP_URL=https://satish.rogan.live

# Real Telegram login; dev mode OFF (it disables auth).
XP_ENV=dev
XP_DEV_MODE=false
# Hackathon demo: lets the "settle" button credit XP with the canned
# Lightning provider. Turn off once a real lnd node is connected.
XP_DEMO_LIGHTNING_SETTLE=false
XP_CORS_ORIGINS=["https://satish.rogan.live"]

# Generate each with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
XP_OPS_OPERATOR_TOKEN=
XP_CONNECTIONS_CREDENTIAL_KEY=

# XP purchases paid in real bitcoin to YOUR wallet. Create it on your own
# computer with:  python3 deploy/make_payment_wallet.py testnet
# (keep the 12 words offline; only the public key goes here). Match the
# network to BITCOIN_NETWORK. MIN_CONF=0 credits as soon as the payment is
# seen (fast for demos; use 1+ for real money).
XP_PAYMENT_MODE=onchain
XP_ONCHAIN_XPUB=
XP_ONCHAIN_NETWORK=testnet
XP_ONCHAIN_MIN_CONF=0
# --- TK: where users pay (your own wallets) ---
# Easiest: the 12 words of YOUR Satish wallet. Then TK paid by Bitcoin lands
# in your Satish Bitcoin wallet and TK paid by Lightning in your Satish
# Lightning wallet. This phrase can spend that wallet: anyone who gets into
# the server gets your coins, so use a separate Satish wallet just for income
# and move money out regularly. Overrides the two options below.
XP_TK_WALLET_MNEMONIC=
# 1 sat = 5 TK, minimum purchase 500 TK, 300 TK free for every account.
# Bitcoin on-chain: XP_ONCHAIN_XPUB above (public key only, can't spend).
# Lightning: the 12/24-word phrase of a Lightning wallet you keep for TK
# income. The server uses it to create invoices and see them paid. It CAN
# spend that wallet, so keep only a small float there and move funds out
# regularly. Uses LIGHTNING_NETWORK / BREEZ_API_KEY below.
XP_TK_LIGHTNING_MNEMONIC=
# Your Satish @username, shown to payers ("Paying to @satish").
XP_TK_PAYEE_USERNAME=
# XP_XP_PER_SAT=5
# XP_TK_WELCOME_BONUS=300
# XP_TK_MIN_PURCHASE=500

# Buy bitcoin in the app (mainnet only). Free account at onramper.com.
# API key from the Onramper dashboard; signing key = Ed25519 private key PEM
# on ONE line with \n for newlines. Make a key pair with:
#   python3 deploy/onramper_keys.py
# then give Onramper the PUBLIC key it prints. Leave blank to show only the
# "buy on an exchange" guide.
XP_ONRAMPER_API_KEY=
XP_ONRAMPER_SIGNING_KEY=
XP_ONRAMPER_DEFAULT_FIAT=NGN

# Real AI answers (platform.deepseek.com -> API keys). Without a key, tasks
# return placeholder output.
XP_DEEPSEEK_API_KEY=

# Real web research (api-search.brave.com, free tier ~2,000 searches/month).
# Without it, research only searches a small built-in sample set.
XP_BRAVE_SEARCH_API_KEY=
XP_BRAVE_SEARCH_COUNTRY=NG
XP_RESEARCH_SEARCH_MODE=auto
XP_RESEARCH_FETCH_MODE=http
